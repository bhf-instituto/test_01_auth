<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <div class="container">

        <!-- Si el usuario no inicio sesión le mostramos login y registro -->

        <% if (typeof email !=='undefined' ) { %>
            <div class="form-container">
                <h2>Hola <%= email %>!</h2>
                <p> Estas en el panel de administración</p>
                <button id="close-session">Cerrar seseión</button>


                <div style="display:flex; flex-direction:column; width: 10rem;">
                    <h2>crear coleccion</h2>
                    <label for="collection-name">nombre de la colección</label>
                    <input type="text" name="collection-name" id="collection-name">

                    <button id="create-collection">Crear colección</button>

                </div>

            </div>
            <% } %>


                <% if (typeof email==='undefined' ) { %>
                    <div class="form-container">
                        <form id="login-form">
                            <h2>Login</h2>

                            <label for="login-email">Email</label>
                            <input type="text" id="login-email" name="login-email" required>

                            <label for="login-password">Password</label>
                            <input type="password" id="login-password" name="login-password" required>

                            <button type="submit">Login</button>
                            <span>&nbsp;</span>
                        </form>
                    </div>

                    <div class="form-container">
                        <form id="register-form">
                            <h2>Register</h2>

                            <label for="register-email">Email</label>
                            <input type="text" id="register-email" name="email" required>

                            <label for="register-password">Password</label>
                            <input type="text" id="register-password" name="password" required>

                            <label for="register-confirm-password">Password</label>
                            <input type="password" id="register-confirm-password" name="confirm-password" required>

                            <button type="submit">Register</button>
                            <span>&nbsp;</span>
                        </form>
                    </div>
                    <% } %>
    </div>

    <script>
        // llamo elementos dentro del dom y los guardo en variable, a partir
        // de CSS. Ya que usa sus selectores como parametro. Entonces $ contiene
        // el primer elemento que coincide con el parametro "el" que se le
        // pase a la funcion $.
        const $ = (el) => document.querySelector(el);

        //llamo a la funcion $ y le pido el primer elemento que contenga ese atributo CSS
        const loginForm = $('#login-form');
        const loginSpan = $('#login-form span');

        const registerForm = $('#register-form');
        const registerSpan = $('#register-form span');

        const createCollectionButton = $('#create-collection')

        const logoutButton = $('#close-session');


        loginForm?.addEventListener('submit', e => {
            e.preventDefault();

            const email = $('#login-email').value;
            const password = $('#login-password').value;

            fetch('/user/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ email, password })
            })
                .then(res => {
                    if (res.ok) {
                        loginSpan.innerText = "Sesión iniciada... entrando..."
                        loginSpan.style.color = 'green'

                        setTimeout(() => {
                            window.location.href = '/user/getAll'
                        }, 1000)
                    } else {
                        loginSpan.innerText = "Error al iniciar sesión"
                        loginSpan.style.color = 'red'

                    }
                })
        })

        registerForm?.addEventListener('submit', e => {
            e.preventDefault();

            const email = $('#register-email').value;
            const password = $('#register-password').value;
            const confirmPassword = $('#register-confirm-password').value;

            if (password !== confirmPassword) {
                alert("passwords do not match");
                return;
            }

            fetch('/user/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ email, password })
            })

                .then(res => {

                    if (res.ok) {
                        registerSpan.innerText = "Sesión registrado... entrando..."
                        registerSpan.style.color = 'green'

                        setTimeout(() => {
                            window.location.href = '/user/protected'
                        }, 1000)
                    } else {
                        registerSpan.innerText = "Error al registrar usuario"
                        registerSpan.style.color = 'red'
                    }
                })
        })

        logoutButton?.addEventListener('click', e => {
            e.preventDefault();

            fetch('/user/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(res => {
                    window.location.href = '/';
                })
        })

        createCollectionButton?.addEventListener('click', e => {
            e.preventDefault();

            const collectionName = $('#collection-name').value;


            fetch('/user/createcollection', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body : JSON.stringify({collectionName})
            })
                .then(res => {
                    window.location.href = '/';
                })
        })

    </script>
</body>

</html>